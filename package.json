{
  "name": "sih-civic-issue-system",
  "version": "1.0.0",
  "description": "Crowdsourced Civic Issue Reporting and Resolution System - SIH 2025",
  "main": "index.js",
  "scripts": {
    "install-all": "npm install --prefix server && npm install --prefix client --legacy-peer-deps",
    "server": "npm run start --prefix server",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix client"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
